# SwiftRide Environment Configuration

# Project & Region
GCLOUD_PROJECT=swift-ride-5ab75
FIREBASE_REGION=us-central1

# Gemini AI (via Firebase AI Logic — no API key needed client-side)
# Flutter clients authenticate automatically via Firebase App Check
# Cloud Functions use Secret Manager / environment for server-side Gemini calls
GEMINI_API_KEY=your-gemini-api-key-here  # For Cloud Functions only (Gemini Developer API, Spark-plan compatible)

# Remote Config Feature Toggles
AI_FEATURES_ENABLED=true
VOICE_ASSISTANT_ENABLED=true
SAFETY_AI_ENABLED=true

# Firebase Project
FIREBASE_PROJECT_ID=swift-ride-5ab75

# Google Maps Platform Keys
# Client keys are NEVER committed. They are injected at build time:
# - iOS:     GOOGLE_MAPS_IOS_API_KEY -> ios/Flutter/Secrets.xcconfig (git-ignored)
#            -> Info.plist $(GMS_API_KEY) -> AppDelegate GMSServices.provideAPIKey()
# - Android: GOOGLE_MAPS_ANDROID_API_KEY -> android/local.properties (git-ignored)
#            -> AndroidManifest ${googleMapsApiKey} placeholder
# In CI (Codemagic) set both as encrypted environment variables; the release
# workflows write the files above and fail the build if either is missing.
# For Cloud Functions, store the server key in Google Cloud Secret Manager:
# `firebase functions:secrets:set GOOGLE_MAPS_SERVER_KEY`
GOOGLE_MAPS_IOS_API_KEY=your-ios-maps-key
GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-key
GOOGLE_MAPS_SERVER_KEY=your-server-maps-key

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_placeholder_swiftride_development
STRIPE_WEBHOOK_SECRET=whsec_placeholder_swiftride_development

# Logging
LOG_LEVEL=info
