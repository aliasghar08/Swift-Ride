# ==============================================================================
# SwiftRide — Comprehensive .gitignore
# Covers Flutter, Dart, iOS, Android, macOS, Web, Firebase Functions & Tooling
# ==============================================================================

# Miscellaneous & Operating Systems
*.class
*.log
*.pyc
*.swp
*.bak
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ & VS Code IDE
*.iml
*.ipr
*.iws
.idea/
.vscode/

# Flutter / Dart Tooling
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Widget Preview
.widget_preview/

# Android Specific
**/android/.gradle/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/captures/
**/android/.externalNativeBuild/
**/android/.cxx/
*.apk
*.aab

# iOS / CocoaPods & Xcode
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
project.xcworkspace/xcuserdata/
Runner.xcodeproj/xcuserdata/

# macOS Desktop
**/macos/Flutter/ephemeral/
**/macos/Pods/
**/macos/Runner/GeneratedPluginRegistrant.*

# Web
**/web/.dart_tool/

# Node.js & Firebase Cloud Functions
**/node_modules/
functions/lib/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
.firebase/

# Security, Certificates & Secrets (Never commit production credentials)
.env
.env.*
!.env.example
*.local
*.p12
*.pem
*.mobileprovision
*.keystore
*.jks
auth_key_*.p8

# Google Maps / platform keys injected at build time (never commit real values)
**/ios/Flutter/Secrets.xcconfig
!**/ios/Flutter/Secrets.xcconfig.example

# Python & Machine Learning
.venv/
**/__pycache__/
ml_pipeline/.venv/

