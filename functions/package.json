{
  "name": "swiftride-functions",
  "version": "1.0.0",
  "description": "SwiftRide Cloud Functions Gen 2 backend",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "test": "vitest run"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.20.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1",
    "geofire-common": "^6.0.0",
    "pino": "^10.3.1",
    "stripe": "^17.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pino": "^7.0.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "private": true
}
