// ==============================================================================
// SwiftRide — LOCAL SECRETS TEMPLATE
// ==============================================================================
// 1. Copy this file:      cp Secrets.xcconfig.example Secrets.xcconfig
// 2. Replace the value with your real Google Maps iOS key.
// 3. NEVER commit Secrets.xcconfig — it is git-ignored.
//
// The key MUST be restricted in Google Cloud Console to:
//   Application restriction : iOS apps
//   Bundle ID               : com.dartnexuslab.swiftride
//   API restriction         : Maps SDK for iOS  (only)
//
// An unrestricted key placed in a mobile binary can be extracted and used to
// drain your Google Maps billing.
// ==============================================================================

GMS_API_KEY = YOUR_IOS_MAPS_API_KEY_HERE
